{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://shopsphere-sd5b.onrender.com/api/v1/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://shopsphere-sd5b.onrender.com/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
